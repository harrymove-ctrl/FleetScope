---
import '../styles/apple.css';
import type { LaunchChapter } from '../features/launch/chapters';
import Fold from '../components/Fold.astro';
import Chapters from '../components/Chapters.astro';
import PeelFooter from '../components/PeelFooter.astro';

/**
 * The public shell.
 *
 * Deliberately shares no stylesheet with `BaseLayout`. That layout carries the
 * operator navigation — Cases, Catalog, Approvals, Audit — which is right for
 * someone already inside the product and wrong for a first visit, and it loads
 * `global.css`, whose `h2 { font-size: 12px; text-transform: uppercase }` is
 * correct for a dense console label and a contradiction of a page whose
 * headlines are 52px.
 *
 * The carousel is an enhancement over the card list below it. That list is
 * server-rendered, is the whole content, and is what remains when WebGL is
 * unavailable, when motion is unwelcome, or below the desktop gate.
 */
interface Props {
  title: string;
  description: string;
  cards: readonly LaunchChapter[];
}

const { title, description, cards } = Astro.props;
const first = cards[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05060a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {first && <link rel="preload" as="image" href={first.src} fetchpriority="high" />}
  </head>
  <body class="ap-body">
    <div class="ap">
      <a class="ap-skip" href="#chapters">Skip to the chapters</a>

      <slot />

      <!--
        The content. Present in every state: the canvas above is aria-hidden
        decoration, so this list is what a screen reader, a text search and a
        visitor without WebGL actually read.
      -->
      <!--
        The chapter list is the face of the cube.

        `Bend` folds it over a top and bottom edge as it scrolls. Where the
        html-in-canvas API is unavailable the component is a passthrough and
        this list scrolls with the page, which is the shape almost every
        visitor gets. See apps/web/src/components/Bend.astro.
      -->
      <Fold>
        <Chapters cards={cards} />
        <Chapters slot="copy-top" cards={cards} decorative />
        <Chapters slot="copy-bottom" cards={cards} decorative />
      </Fold>
    </div>

    <PeelFooter />
  </body>
</html>

<!--
  Why the fold is a pixel effect and not a CSS transform.

  The obvious version — rotate each chapter row about its own edge — was built
  first and broke the page. Rows are around 300px tall; an 80-degree rotation
  projects a row roughly its own height across the screen, so several fold at
  once and overlap into the header. That is not a tuning problem. A row is
  atomic: it cannot be half-folded, so the fold either misses the crease or
  swings the whole row.

  canvas-ui avoids this by folding a viewport-sized surface of *pixels*
  captured with `drawElementImage`, bending only the part inside the zone. The
  crease can then fall anywhere, including mid-paragraph.

  `features/launch/bend.ts` keeps the per-element maths and its tests. It is
  not on the page and is not the shipped effect.
-->

<style>
  /*
   * The plane the peel footer hides behind.
   *
   * `PeelFooter` is fixed at z-index 0; this has to be opaque and above it, or
   * the footer shows through the page instead of from under it.
   */
  .ap {
    position: relative;
    z-index: 1;
    background: var(--ap-bg);
    box-shadow: 0 10px 30px rgb(0 0 0 / 18%);
  }

  .ap-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 12px 20px;
    background: var(--ap-bg-2);
    color: var(--ap-ink);
  }
  .ap-skip:focus {
    left: 0;
  }

  /* The host owns a viewport of height; the chapters scroll inside it. */
  :global(.bend-host) {
    height: 100vh;
  }

</style>
