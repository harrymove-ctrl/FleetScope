<div class="viewer-loader" data-viewer-loader aria-hidden="true" hidden>
  <canvas class="viewer-loader__canvas" data-viewer-loader-canvas></canvas>
</div>

<script>
  import { WildType } from '../features/viewer/wild-type/engine';

  const host = document.querySelector<HTMLElement>('[data-viewer-loader]');
  const canvas = host?.querySelector<HTMLCanvasElement>('[data-viewer-loader-canvas]');

  if (host && canvas) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MIN_VISIBLE_MS = 3500;
    const MAX_WAIT_MS = 7200;
    const startedAt = performance.now();
    let engine: WildType | null = null;
    let ready = false;
    let readyAt = Number.POSITIVE_INFINITY;
    let exiting = false;

    const finish = (): void => {
      if (exiting) return;
      exiting = true;
      engine?.stop();
      host.classList.add('is-leaving');
      window.setTimeout(() => {
        engine?.destroy();
        host.remove();
      }, 520);
    };

    const markReady = (): void => {
      ready = true;
      readyAt = performance.now();
    };

    if (reduced) {
      host.remove();
    } else {
      host.hidden = false;
      void document.fonts.ready.then(() => {
        if (!document.contains(canvas)) return;
        engine = new WildType(canvas, "ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', sans-serif");
        if (!engine.ok) {
          finish();
          return;
        }
        engine.start();
      });

      const point = (event: PointerEvent): void => {
        const rect = canvas.getBoundingClientRect();
        engine?.setPointer(event.clientX - rect.left, event.clientY - rect.top);
      };
      const clearPoint = (): void => engine?.setPointer(null, null);
      canvas.addEventListener('pointermove', point);
      canvas.addEventListener('pointerleave', clearPoint);
      canvas.addEventListener('pointercancel', clearPoint);

      let resizeTimer = 0;
      window.addEventListener(
        'resize',
        () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => engine?.resize(), 120);
        },
        { passive: true },
      );
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) engine?.stop();
        else engine?.start();
      });
      window.addEventListener('fleetscope:viewer-ready', markReady, { once: true });
      window.setTimeout(() => {
        if (!ready) markReady();
      }, MAX_WAIT_MS);

      const watch = (): void => {
        if (
          ready &&
          performance.now() - startedAt >= MIN_VISIBLE_MS &&
          performance.now() - readyAt > 320
        ) {
          finish();
          return;
        }
        window.requestAnimationFrame(watch);
      };
      window.requestAnimationFrame(watch);
    }
  }
</script>

<style>
  .viewer-loader {
    position: fixed;
    inset: 0;
    z-index: 120;
    overflow: hidden;
    background: #000;
    opacity: 1;
    transition: opacity 520ms ease;
  }

  .viewer-loader.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .viewer-loader__canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer-loader {
      display: none;
    }
  }
</style>
