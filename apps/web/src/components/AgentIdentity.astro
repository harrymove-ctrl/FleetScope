---
/**
 * Deterministic, dependency-free agent identity.
 *
 * This is the Astro-native equivalent of a presence avatar: the face is a
 * visual index, never the source of truth. Historical FleetScope states are
 * rendered beside it as words, so a recorded agent can never look "online".
 */
interface Props {
  agentId: string;
  label: string;
  state?: string | null;
  size?: 'sm' | 'md';
}

import { agentIdentityEye, agentIdentityVariant } from '../lib/agent-identity';

const { agentId, label, state = null, size = 'md' } = Astro.props;
const variant = agentIdentityVariant(agentId);
const eye = agentIdentityEye(agentId);
const safeState = state ?? 'unknown';
---

<span
  class={`fs-agent-identity fs-agent-identity--${size} fs-agent-identity--v${variant}`}
  data-agent-identity={agentId}
  data-agent-state={safeState}
  title={`${label} · ${safeState}`}
  role="img"
  aria-label={`${label}, ${safeState}`}
>
  <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <path class="fs-agent-identity__body" d={variant % 2 === 0 ? 'M8 20C8 10 14 5 21 5c8 0 13 6 12 16-1 9-6 14-14 14C11 35 8 29 8 20Z' : 'M7 18C8 9 15 5 23 6c8 1 12 7 10 16-2 9-7 13-15 12C10 33 6 28 7 18Z'} />
    <circle class="fs-agent-identity__eye" cx="16" cy={eye === 0 ? 19 : 18} r="2" />
    <circle class="fs-agent-identity__eye" cx="26" cy={eye === 2 ? 20 : 18} r="2" />
    <path class="fs-agent-identity__mouth" d="M16 26c3 2 6 2 9 0" />
  </svg>
</span>
