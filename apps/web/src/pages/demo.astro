---
/**
 * Judge/video poster for the bundled Agent Viewer recording.
 *
 * Zero interaction by design: no buttons, no fullscreen, no Follow, no WASM,
 * no model start. Scroll to read. Site nav is the only way to leave.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionGraphs from '../components/SessionGraphs.astro';
import { sessionStatusLine } from '../features/viewer/graphs';

const statusLine = sessionStatusLine();
---

<BaseLayout title="Session readings" wide surface="feature" theme="adaptive">
  <article class="demo-poster" data-demo-poster data-interactive="false">
    <header class="demo-poster__bar">
      <p class="demo-poster__kicker">
        <span class="demo-poster__orb" aria-hidden="true"></span>
        Gemini · Antigravity · recorded session
      </p>
      <h1>Session readings</h1>
      <p class="demo-poster__status" data-demo-line>{statusLine}</p>
    </header>

    <SessionGraphs />

    <footer class="demo-poster__footnote">
      <span>Recorded evidence only · no upload · no model call · no controls on this page</span>
      <span>Producer: <code>pnpm demo:antigravity</code></span>
    </footer>
  </article>
</BaseLayout>

<style>
  .demo-poster {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: clamp(8px, 2vw, 24px) 0 clamp(48px, 8vw, 96px);
  }

  .demo-poster__bar {
    margin-bottom: clamp(36px, 6vw, 64px);
  }

  .demo-poster__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--fd-cyan);
    font: 500 10px/1 var(--fs-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .demo-poster__orb {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4285f4, #8430ce 55%, #fbbc05);
    box-shadow: 0 0 0 3px color-mix(in srgb, #8430ce 18%, transparent);
  }

  .demo-poster h1 {
    margin: 0;
    color: var(--fd-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .demo-poster__status {
    margin: 18px 0 0;
    max-width: 46rem;
    color: var(--fd-text);
    font: 500 clamp(13px, 1.5vw, 16px) / 1.55 var(--fs-mono);
  }

  .demo-poster__footnote {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(48px, 8vw, 88px);
    padding-top: 18px;
    border-top: 1px solid var(--fd-line);
    color: var(--fd-faint);
    font: 500 11px/1.6 var(--fs-mono);
  }

  .demo-poster__footnote code {
    color: var(--fd-muted);
    font: inherit;
  }

  /* Poster body: no pointer affordances that look like controls. */
  .demo-poster :is(button, [data-fullscreen-toggle], summary) {
    display: none !important;
  }
</style>
