---
/**
 * Judge/video poster: live local TUI (loopback JSONL) plus the bundled
 * recorded readings. No WASM, no model start. Site nav is the only way to leave.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionGraphs from '../components/SessionGraphs.astro';
import { sessionStatusLine } from '../features/viewer/graphs';

const statusLine = sessionStatusLine();
---

<BaseLayout title="Session readings" wide surface="feature" theme="adaptive">
  <article class="demo-poster" data-demo-poster data-interactive="false">
    <header class="demo-poster__bar">
      <p class="demo-poster__kicker">
        <span class="demo-poster__orb" aria-hidden="true"></span>
        Gemini · Antigravity · live TUI + recorded fixture
      </p>
      <h1>Session readings</h1>
      <p class="demo-poster__status" data-demo-line>{statusLine}</p>
      <p class="demo-poster__status">
        The boxed TUI below is the newest local <code>agy</code> session (loopback
        JSONL). The seven glyph readings under it are a <strong>bundled recorded
        fixture</strong> (coordinator / flight_search) — they are not the live
        four-subagent run. Live graph: <a href="/viewer">/viewer</a>.
      </p>
    </header>

    <section class="live-tui" aria-labelledby="live-tui-title">
      <h2 id="live-tui-title">Live TUI (this machine)</h2>
      <p class="live-tui__lede" data-live-tui-status>Looking for .fleetscope/sessions…</p>
      <div class="live-tui__graph" data-live-tui-graph></div>
    </section>

    <SessionGraphs />

    <footer class="demo-poster__footnote">
      <span>Recorded evidence only · no upload · no model call · no controls on this page</span>
      <span>Producer: <code>pnpm demo:antigravity</code></span>
    </footer>
  </article>
</BaseLayout>

<style>
  .demo-poster {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: clamp(8px, 2vw, 24px) 0 clamp(48px, 8vw, 96px);
  }

  .demo-poster__bar {
    margin-bottom: clamp(36px, 6vw, 64px);
  }

  .demo-poster__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--fd-cyan);
    font: 500 10px/1 var(--fs-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .demo-poster__orb {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4285f4, #8430ce 55%, #fbbc05);
    box-shadow: 0 0 0 3px color-mix(in srgb, #8430ce 18%, transparent);
  }

  .demo-poster h1 {
    margin: 0;
    color: var(--fd-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .demo-poster__status {
    margin: 18px 0 0;
    max-width: 46rem;
    color: var(--fd-text);
    font: 500 clamp(13px, 1.5vw, 16px) / 1.55 var(--fs-mono);
  }

  .demo-poster__footnote {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(48px, 8vw, 88px);
    padding-top: 18px;
    border-top: 1px solid var(--fd-line);
    color: var(--fd-faint);
    font: 500 11px/1.6 var(--fs-mono);
  }

  .demo-poster__footnote code {
    color: var(--fd-muted);
    font: inherit;
  }

  /* Poster body: no pointer affordances that look like controls. */
  .demo-poster :is(button, [data-fullscreen-toggle], summary) {
    display: none !important;
  }

  .live-tui {
    margin: 0 0 clamp(48px, 8vw, 88px);
    padding: 18px;
    border: 1px solid #111;
    background: #fff;
    color: #111;
    font: 13px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .live-tui h2 {
    margin: 0 0 8px;
    font: 600 14px/1.2 inherit;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .live-tui__lede,
  .live-tui__meta,
  .live-tui__empty {
    margin: 0 0 16px;
    color: #444;
  }

  .live-tui__row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  .live-tui__card {
    flex: 1 1 220px;
    max-width: 340px;
    padding: 10px 12px;
    border: 1px solid #111;
    background: #fff;
  }

  .live-tui__card h3 {
    margin: 0 0 8px;
    font: 700 13px/1.2 inherit;
  }

  .live-tui__card p {
    margin: 0 0 8px;
  }

  .live-tui__stats {
    color: #444;
    font-size: 12px;
  }

  .live-tui__card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: #333;
    font-size: 12px;
  }
</style>

<script>
  import { parseAdkSession, renderLiveTuiHtml } from '../features/viewer/live-tui';

  const status = document.querySelector('[data-live-tui-status]');
  const graph = document.querySelector('[data-live-tui-graph]');

  async function bootLiveTui() {
    if (!status || !graph) return;
    try {
      const listed = await fetch('/local-sessions.json', { cache: 'no-store' });
      if (!listed.ok) {
        status.textContent =
          'Local sessions are loopback-only. Open this page on 127.0.0.1:4321 while pnpm dev:web is running. Hosted Cloud Run has no live agy JSONL.';
        return;
      }
      const rows = (await listed.json()) as Array<{ id: string }>;
      const newest = rows[0];
      if (!newest) {
        status.textContent =
          'No local session.jsonl yet. Run pnpm demo:agy, chat at >, then refresh. The seven readings below stay the bundled fixture.';
        return;
      }
      const body = await fetch(`/local-sessions/${encodeURIComponent(newest.id)}/session.jsonl`);
      if (!body.ok) {
        status.textContent = `Could not read ${newest.id}.`;
        return;
      }
      const cards = parseAdkSession(await body.text());
      status.textContent = `Newest local session · ${newest.id}`;
      graph.innerHTML = renderLiveTuiHtml(newest.id, cards);
    } catch {
      status.textContent =
        'Could not list local sessions. /demo never starts agy; it only reads JSONL already on disk.';
    }
  }

  void bootLiveTui();
</script>
