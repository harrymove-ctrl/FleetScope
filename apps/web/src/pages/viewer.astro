---
/**
 * The Agent Viewer in the browser.
 *
 * The second frontend over the same projection core the `fleetscope` command
 * uses. Everything that decides what a session MEANS — detection, parsing, the
 * wire emitter, the fold — is Rust compiled to wasm and shared verbatim with
 * the CLI. This page owns file input, the status readout and the controls, and
 * nothing else.
 *
 * It reads files the visitor chooses, in their browser. Nothing is uploaded:
 * there is no fetch in the load path and no backend to send a session to.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import '../styles/feature-viewer.css';
---

<BaseLayout title="Agent Viewer" wide surface="feature" theme="adaptive">
  <div class="viewer-page">
    <PageHeader
      title="Agent Viewer"
      lede="A Gemini / Antigravity flight deck for local agent sessions. Files stay in your browser and are never uploaded."
    >
      <span slot="badges" class="viewer-kicker"><span class="gemini-orb" aria-hidden="true"></span> GEMINI SIGNAL</span>
      <button slot="actions" class="fs-button viewer-action" data-variant="primary" data-load-demo>Load bundled demo</button>
      <button slot="actions" class="fs-button viewer-action" data-pick-file>Open file…</button>
      <button slot="actions" class="fs-button viewer-action" data-pick-folder>Open folder…</button>
    </PageHeader>

  <input type="file" data-file-input hidden accept=".jsonl,.json" />
  <!-- `webkitdirectory` is how a browser offers folder selection. A session is
       a transcript plus a tree of per-agent files beside it, so picking the
       folder is the only way to get the sub-agents. It is set from script
       because it is not in the standard attribute types. -->
  <input type="file" data-folder-input hidden multiple />

  <div class="fs-stack">
    <!--
      The shell around the renderer. Rust owns the graph and every fact about
      the session; this markup owns arrangement. Every value below is written
      by the script from the WASM ABI, so nothing here is a placeholder that
      could be right on screen and wrong in fact.
    -->
    <!--
      Story Mode. Answers "what happened, what did FleetScope do, did it
      recover" before anything technical. Every string is written by the script
      from facts the Rust side computed; a claim with no evidence behind it is
      rendered as an absence, never as a claim with a caveat under it.
    -->
    <section class="story fs-feature-section" aria-labelledby="story-title" data-story>
      <p class="story__source" data-story-source>—</p>
      <h2 id="story-title" class="story__outcome" data-story-outcome>Reading the session…</h2>
      <p class="story__summary" data-story-summary></p>

      <ul class="story__cards" data-story-cards role="list"></ul>
      <p class="story__disclosure" data-story-disclosure hidden></p>

      <nav class="story__chapters" aria-label="Session chapters">
        <ul data-story-chapters role="list"></ul>
      </nav>

      <div class="story__narrative">
        <div>
          <h3>What happened</h3>
          <p data-story-problem></p>
        </div>
        <div>
          <h3>What FleetScope did</h3>
          <p data-story-action></p>
        </div>
        <div>
          <h3>Result</h3>
          <p data-story-result></p>
        </div>
      </div>

      <button class="fs-button" type="button" data-expert-toggle aria-expanded="false">
        Open technical evidence
      </button>
    </section>

    <section class="viewer-shell fs-viewer__drop" data-dropzone>
      <header class="viewer-shell__header">
        <div class="fs-viewer__meta" data-status role="status" aria-live="polite">
          Loading the viewer…
        </div>
        <div class="viewer-shell__transport">
          <span class="fs-status" data-tone="info" data-transport-badge>
            <span class="fs-status__glyph" aria-hidden="true">·</span>
            <span data-transport-label>Loading</span>
          </span>
          <span class="fs-mono fs-faint" data-position>—</span>
          <span class="viewer-shell__controls">
            <button class="fs-button fs-button--sm" type="button" data-transport-toggle disabled>
              Pause
            </button>
            <button class="fs-button fs-button--sm" type="button" data-go-live disabled>
              Latest event
            </button>
            <button class="fs-button fs-button--sm" type="button" data-fit-graph disabled>
              Fit graph
            </button>
          </span>
        </div>
      </header>

      <p class="fs-viewer__hint">
        Drop a session file here, or a folder containing one. Space plays and pauses,
        <kbd>←</kbd>/<kbd>→</kbd> step, <kbd>g</kbd> jumps to the end, <kbd>o</kbd> fits the graph,
        <kbd>?</kbd> shows every key.
      </p>

      <div class="viewer-shell__body">
        <aside class="viewer-shell__rail" aria-labelledby="rail-title">
          <h2 id="rail-title" class="viewer-shell__panel-title">Agents</h2>
          <ul class="viewer-rail" data-agent-rail role="list">
            <li class="fs-muted viewer-rail__empty">—</li>
          </ul>
        </aside>

        <!-- The renderer owns this subtree entirely. Nothing else writes into it. -->
        <div
          id="agent-viewer-canvas"
          class="fs-viewer__canvas"
          role="img"
          aria-label="Agent Viewer session graph"
          aria-describedby="fs-viewer-fallback"
        >
          <p class="fs-placeholder" id="fs-viewer-fallback" data-fallback>
            Loading the Agent Viewer…
          </p>
        </div>

        <aside class="viewer-shell__inspector" aria-labelledby="inspector-title">
          <h2 id="inspector-title" class="viewer-shell__panel-title">Inspector</h2>
          <div class="viewer-inspector" data-inspector aria-live="polite">
            <p class="fs-muted">Select an event or an agent.</p>
          </div>
        </aside>
      </div>

      <footer class="viewer-shell__timeline" aria-labelledby="timeline-title" data-expert hidden>
        <div class="fs-row fs-row--between">
          <h2 id="timeline-title" class="viewer-shell__panel-title">Timeline</h2>
          <span class="fs-mono fs-faint" data-timeline-count>—</span>
        </div>
        <ol class="viewer-timeline" data-timeline role="list">
          <li class="fs-muted viewer-timeline__empty">—</li>
        </ol>
        <button class="fs-button fs-button--sm" type="button" data-timeline-more hidden>
          Load more events
        </button>
      </footer>
    </section>

    <section class="fs-feature-section viewer-summary" data-expert hidden>
      <h2>Session summary</h2>
      <p class="fs-muted">
        The same text <code>fleetscope inspect</code> prints, produced by the same code. It reports
        the full agent tree, including depth the graph flattens.
      </p>
      <pre class="fs-viewer__summary" data-summary>—</pre>
    </section>
  </div>
</BaseLayout>

<!-- Viewer composition is isolated in styles/feature-viewer.css. -->

<script>
  import {
    agentRows,
    eventsForAgent,
    foreignEventNote,
    graphNodeIds as toGraphNodeIds,
    inspectorFields,
    positionLabel,
    transportBadge,
    NO_EVENT_MESSAGE,
    type AgentSummary,
    type EventDetail,
    type GraphNode,
    type SelectionAnswer,
    type EventSummary,
    type EventWindow,
    type SelectionSignal,
    type Snapshot,
  } from '../features/viewer/shell';
  import { agentIdentityEye, agentIdentityVariant } from '../lib/agent-identity';
  import {
    chaptersFrom,
    localStory,
    type Chapter,
    type StoryFacts,
  } from '../features/story/story';

  const statusEl = document.querySelector('[data-status]') as HTMLElement | null;
  const summaryEl = document.querySelector('[data-summary]') as HTMLElement | null;
  const fallbackEl = document.querySelector('[data-fallback]') as HTMLElement | null;
  const dropzone = document.querySelector('[data-dropzone]') as HTMLElement | null;
  const fileInput = document.querySelector('[data-file-input]') as HTMLInputElement | null;
  const folderInput = document.querySelector('[data-folder-input]') as HTMLInputElement | null;

  /** Files a session can be made of. Anything else in a folder is ignored. */
  const READABLE = /\.(jsonl|json)$/i;

  type Api = {
    agent_viewer_load: (name: string, main: string, companions: string) => string;
    agent_viewer_load_demo: () => string;
    agent_viewer_summary: () => string;
    agent_viewer_fingerprint: () => string;
    agent_viewer_snapshot: () => string;
    agent_viewer_events: (offset: number, limit: number) => string;
    agent_viewer_agents: () => string;
    agent_viewer_seek_sequence: (sequence: number) => boolean;
    agent_viewer_event_detail: (sequence: number) => string;
    agent_viewer_story_facts: () => string;
    agent_viewer_select_agent: (agentId: string) => string;
    agent_viewer_clear_selection: () => boolean;
    agent_viewer_graph_nodes: () => string;
    agent_viewer_fit_graph: () => void;
    agent_viewer_go_live: () => void;
    agent_viewer_toggle_play: () => void;
  };

  let api: Api | null = null;

  function say(message: string, bad = false) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.bad = String(bad);
  }

  function report(statusJson: string) {
    let parsed: Record<string, unknown>;
    try {
      parsed = JSON.parse(statusJson);
    } catch {
      say('The viewer returned a status this page could not read.', true);
      return;
    }
    const bits = [
      `session ${parsed.sessionId}`,
      `${parsed.adapter}`,
      `${parsed.agents} agents`,
      `${parsed.events} events`,
      `fingerprint ${parsed.fingerprint}`,
    ];
    // The flatten note is the renderer admitting what it could not draw. It is
    // not decoration: without it a deep session looks flat and correct.
    if (parsed.flattenNote) bits.push(String(parsed.flattenNote));
    say(bits.join('  ·  '));
    if (summaryEl && api) summaryEl.textContent = api.agent_viewer_summary();
    reloadShellData();
  }

  /** Read one File as text, rejecting nothing: an unreadable file is reported. */
  const readText = (file: File): Promise<string> => file.text();

  async function loadFiles(files: File[]) {
    const readable = files.filter((file) => READABLE.test(file.name));
    if (readable.length === 0) {
      say('No .jsonl or .json session file in that selection.', true);
      return;
    }

    // The main transcript is the largest top-level file. Per-agent files live
    // in a directory beside it, so they are deeper in the relative path.
    const depth = (file: File) => (file.webkitRelativePath || file.name).split('/').length;
    const shallowest = Math.min(...readable.map(depth));
    const candidates = readable.filter((file) => depth(file) === shallowest);
    const main = candidates.reduce((a, b) => (a.size >= b.size ? a : b));

    const mainPath = main.webkitRelativePath || main.name;
    const root = mainPath.replace(/\.[^./]+$/, '');

    const companions = await Promise.all(
      readable
        .filter((file) => file !== main)
        .map(async (file) => {
          const path = file.webkitRelativePath || file.name;
          // Name each companion relative to the session's own directory, which
          // is the contract the adapters read.
          const name = path.startsWith(`${root}/`) ? path.slice(root.length + 1) : path;
          return { name, text: await readText(file) };
        }),
    );

    try {
      const status = api!.agent_viewer_load(
        main.name,
        await readText(main),
        JSON.stringify(companions),
      );
      report(status);
    } catch (error) {
      // Say WHY. A viewer that fails to a blank canvas is worse than one that
      // refuses a file and names the reason.
      say(error instanceof Error ? error.message : String(error), true);
    }
  }

  /**
   * Wait until the renderer's host element has a measured width.
   *
   * WHY THIS EXISTS: ratzilla sizes the terminal grid from
   * `parent.client_width()` exactly ONCE, at construction
   * (`ratzilla/src/backend/webgl2.rs`, `init_beamterm`), and nothing
   * re-derives it afterwards. If the glue loads before layout has settled the
   * grid is built at zero columns and the canvas stays blank forever, while
   * every other signal — the status line, the summary, the fingerprint —
   * looks correct. Waiting for one real measurement is the whole fix.
   *
   * Bounded, and it resolves either way: in a tab that never lays out (a
   * background tab, a headless probe) the renderer should still load and
   * degrade the way it always did, not hang.
   */
  function waitForMeasuredHost(id: string): Promise<void> {
    return new Promise<void>((resolve) => {
      const host = document.getElementById(id);
      if (host === null) return resolve();
      const started = performance.now();
      let timer = 0;
      const finish = () => {
        document.removeEventListener('visibilitychange', check);
        window.clearTimeout(timer);
        resolve();
      };
      const check = (): void => {
        if ((!document.hidden && host.clientWidth > 0) || performance.now() - started > 5000) {
          finish();
          return;
        }
        requestAnimationFrame(check);
      };
      document.addEventListener('visibilitychange', check);
      timer = window.setTimeout(check, 5100);
      requestAnimationFrame(check);
    });
  }

  /**
   * Load the generated wasm-bindgen glue.
   *
   * It is a build artifact in /public — outside Vite's module graph and outside
   * TypeScript's view of the project. A direct `import()` from this module does
   * NOT work: in dev Vite rewrites the request and refuses it, and in a
   * production build it injects a `__VITE_PRELOAD__` reference that is not
   * defined at runtime. The import therefore has to originate from a script
   * element the bundler never sees, which is what this does.
   */
  function loadGlue(): Promise<void> {
    return new Promise((resolve, reject) => {
      const onReady = (event: Event) => {
        window.removeEventListener('fleetscope:viewer-glue', onReady);
        const detail = (event as CustomEvent<{ ok: boolean; message?: string }>).detail;
        if (detail.ok) resolve();
        else reject(new Error(detail.message ?? 'unknown error'));
      };
      window.addEventListener('fleetscope:viewer-glue', onReady);

      const loader = document.createElement('script');
      loader.type = 'module';
      loader.textContent = [
        "import('/wasm/viewer.js')",
        '  .then(async (module) => {',
        '    await module.default();',
        '    globalThis.fleetscopeViewer = module;',
        "    window.dispatchEvent(new CustomEvent('fleetscope:viewer-glue', { detail: { ok: true } }));",
        '  })',
        '  .catch((error) => {',
        "    window.dispatchEvent(new CustomEvent('fleetscope:viewer-glue', {",
        '      detail: { ok: false, message: String((error && error.message) || error) },',
        '    }));',
        '  });',
      ].join('\n');
      document.body.appendChild(loader);
    });
  }

  async function boot() {
    try {
      await waitForMeasuredHost('agent-viewer-canvas');
      await loadGlue();
      const module = (globalThis as { fleetscopeViewer?: Api }).fleetscopeViewer;
      // Assert the ABI by name, so a partial load fails here rather than at the
      // first call site with an unhelpful "not a function".
      if (!module || typeof module.agent_viewer_load_demo !== 'function') {
        throw new Error('the renderer loaded without its expected ABI');
      }
      api = module;
      fallbackEl?.remove();
      report(module.agent_viewer_load_demo());
    } catch (error) {
      say(
        `The Agent Viewer renderer could not be loaded (${
          error instanceof Error ? error.message : 'unknown error'
        }). Run pnpm build:wasm.`,
        true,
      );
    }
  }

  // ── The shell ─────────────────────────────────────────────────────────
  //
  // Every value rendered below is read from the ABI. Nothing here derives
  // agent status, event identity, a renderer index or the offset between the
  // two: those are decided in Rust and a second answer in TypeScript would
  // drift from the first.

  /** How many events one page of the timeline asks for. */
  const PAGE = 100;

  let agents: AgentSummary[] = [];
  let events: EventSummary[] = [];
  let hasMore = false;
  let selectedSequence: number | null = null;
  let selectedAgentId: string | null = null;
  /**
   * The ids the RENDERER has as graph nodes. A rail row is only presented as a
   * graph-node control when its id appears here, so a control can never claim
   * to select a node the graph does not have.
   */
  let graphNodeIds: ReadonlySet<string> = new Set();

  /**
   * The rail is populated after the WASM projection, so it cannot use an Astro
   * component. It still uses the same deterministic identity calculation as
   * the server-rendered Cockpit rail; the avatar is decoration and the label
   * and historical status remain the accessible source of truth.
   */
  function createAgentIdentity(row: ReturnType<typeof agentRows>[number]): HTMLSpanElement {
    const identity = document.createElement('span');
    identity.className = `fs-agent-identity fs-agent-identity--sm fs-agent-identity--v${agentIdentityVariant(row.id)}`;
    identity.dataset.agentIdentity = row.id;
    identity.dataset.agentState = row.statusLabel;
    identity.title = `${row.label} · ${row.statusLabel}`;
    identity.setAttribute('role', 'img');
    identity.setAttribute('aria-label', `${row.label}, ${row.statusLabel}`);

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 40 40');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    const variant = agentIdentityVariant(row.id);
    const eye = agentIdentityEye(row.id);
    const body = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    body.setAttribute(
      'd',
      variant % 2 === 0
        ? 'M8 20C8 10 14 5 21 5c8 0 13 6 12 16-1 9-6 14-14 14C11 35 8 29 8 20Z'
        : 'M7 18C8 9 15 5 23 6c8 1 12 7 10 16-2 9-7 13-15 12C10 33 6 28 7 18Z',
    );
    body.classList.add('fs-agent-identity__body');
    const leftEye = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    leftEye.setAttribute('cx', '16');
    leftEye.setAttribute('cy', eye === 0 ? '19' : '18');
    leftEye.setAttribute('r', '2');
    leftEye.classList.add('fs-agent-identity__eye');
    const rightEye = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    rightEye.setAttribute('cx', '26');
    rightEye.setAttribute('cy', eye === 2 ? '20' : '18');
    rightEye.setAttribute('r', '2');
    rightEye.classList.add('fs-agent-identity__eye');
    const mouth = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    mouth.setAttribute('d', 'M16 26c3 2 6 2 9 0');
    mouth.classList.add('fs-agent-identity__mouth');
    svg.append(body, leftEye, rightEye, mouth);
    identity.append(svg);
    return identity;
  }

  const railEl = document.querySelector('[data-agent-rail]');
  const timelineEl = document.querySelector('[data-timeline]');
  const timelineCountEl = document.querySelector('[data-timeline-count]');
  const moreEl = document.querySelector('[data-timeline-more]') as HTMLButtonElement | null;
  const inspectorEl = document.querySelector('[data-inspector]');
  const badgeEl = document.querySelector('[data-transport-badge]');
  const badgeLabelEl = document.querySelector('[data-transport-label]');
  const positionEl = document.querySelector('[data-position]');
  const toggleEl = document.querySelector('[data-transport-toggle]') as HTMLButtonElement | null;
  const goLiveEl = document.querySelector('[data-go-live]') as HTMLButtonElement | null;
  const fitEl = document.querySelector('[data-fit-graph]') as HTMLButtonElement | null;

  const snapshot = (): Snapshot | null => {
    if (api === null) return null;
    try {
      return JSON.parse(api.agent_viewer_snapshot()) as Snapshot;
    } catch {
      return null;
    }
  };

  function renderHeader(snap: Snapshot) {
    const badge = transportBadge(snap);
    badgeEl?.setAttribute('data-tone', badge.tone);
    if (badgeLabelEl !== null) badgeLabelEl.textContent = badge.label;
    const glyph = badgeEl?.querySelector('.fs-status__glyph');
    if (glyph !== null && glyph !== undefined) glyph.textContent = badge.glyph;
    if (positionEl !== null) positionEl.textContent = positionLabel(snap);
    // The renderer reports whether it is playing; the button says what pressing
    // it will do, which is the opposite.
    if (toggleEl !== null) toggleEl.textContent = snap.transport === 'playing' ? 'Pause' : 'Play';
    for (const control of [toggleEl, goLiveEl, fitEl]) control?.removeAttribute('disabled');
  }

  /**
   * Update only the state of rail controls that already exist.
   *
   * Returns false when the row set itself changed and a rebuild is needed.
   *
   * # Why this exists
   *
   * The shell refreshes once a second. Rebuilding the rail every time destroys
   * whichever control the keyboard user was on, so focus fell back to `<body>`
   * within a second of arriving and Enter did nothing. That is invisible to a
   * mouse and fatal to a keyboard, and it made the browser check fail
   * intermittently at one viewport before it was understood.
   */
  function updateRailState(): boolean {
    if (railEl === null) return false;
    const buttons = Array.from(
      railEl.querySelectorAll<HTMLButtonElement>('button[data-agent-id]'),
    );
    const rows = agentRows(agents);
    if (buttons.length !== rows.length) return false;
    if (buttons.some((button, i) => button.dataset.agentId !== rows[i]?.id)) return false;

    for (const button of buttons) {
      const isSelected = button.dataset.agentId === selectedAgentId;
      button.setAttribute('aria-pressed', String(isSelected));
      button.setAttribute('aria-current', String(isSelected));
    }
    return true;
  }

  function renderRail() {
    if (railEl === null) return;
    if (updateRailState()) return;
    railEl.replaceChildren();
    if (agents.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'fs-muted viewer-rail__empty';
      empty.textContent = 'No agents in this session.';
      railEl.append(empty);
      return;
    }
    for (const row of agentRows(agents)) {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'viewer-rail__row';
      button.dataset.agentId = row.id;
      button.style.paddingLeft = `${8 + row.depth * 14}px`;
      const isNode = graphNodeIds.has(row.id);
      const isSelected = row.id === selectedAgentId;
      // `aria-pressed` because activating the control again releases it: this
      // is a toggle, and `aria-current` alone would not say that.
      button.setAttribute('aria-pressed', String(isSelected));
      button.setAttribute('aria-current', String(isSelected));
      if (isNode) {
        // The hook a test uses to reach a NAMED graph node rather than a pixel.
        button.dataset.graphNode = row.id;
      } else {
        // Honest: the renderer has no node for this agent, so this control
        // cannot select one. Say so instead of failing silently on activation.
        button.disabled = true;
        button.title = 'This agent has no graph node in the current fold.';
      }

      const identity = createAgentIdentity(row);

      const label = document.createElement('span');
      label.className = 'viewer-rail__label';
      label.textContent = row.label;

      const status = document.createElement('span');
      status.className = 'fs-status';
      status.setAttribute('data-tone', row.statusTone);
      // A word, not only a colour.
      status.textContent = row.statusLabel;

      const meta = document.createElement('span');
      meta.className = 'viewer-rail__meta';
      meta.textContent =
        row.errorCount > 0 ? `${row.eventCount} ev · ${row.errorCount} err` : `${row.eventCount} ev`;

      button.append(identity, label, status, meta);
      // The accessible-name algorithm drops whitespace-only text nodes between
      // spans, so the computed name would run the label into the status word.
      button.setAttribute(
        'aria-label',
        `${row.label} — ${row.statusLabel}, ${row.eventCount} events`,
      );
      button.addEventListener('click', () => selectAgent(row.id));
      li.append(button);
      railEl.append(li);
    }
  }

  /** The timeline's equivalent of `updateRailState`, for the same reason. */
  function updateTimelineState(shown: readonly EventSummary[]): boolean {
    if (timelineEl === null) return false;
    const buttons = Array.from(
      timelineEl.querySelectorAll<HTMLButtonElement>('button[data-sequence]'),
    );
    if (buttons.length !== shown.length) return false;
    if (buttons.some((button, i) => button.dataset.sequence !== String(shown[i]?.sequence)))
      return false;

    for (const button of buttons) {
      button.setAttribute(
        'aria-current',
        String(Number(button.dataset.sequence) === selectedSequence),
      );
    }
    return true;
  }

  function renderTimeline() {
    if (timelineEl === null) return;
    const shownRows = eventsForAgent(events, selectedAgentId);
    if (updateTimelineState(shownRows)) {
      if (timelineCountEl !== null) {
        timelineCountEl.textContent =
          selectedAgentId === null
            ? `${events.length} loaded`
            : `${shownRows.length} of ${events.length} loaded`;
      }
      if (moreEl !== null) moreEl.hidden = !hasMore;
      return;
    }
    timelineEl.replaceChildren();
    const shown = eventsForAgent(events, selectedAgentId);
    if (shown.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'fs-muted viewer-timeline__empty';
      empty.textContent = 'No events to show.';
      timelineEl.append(empty);
    }
    for (const event of shown) {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'viewer-timeline__row';
      // The canonical key, and the only thing a click sends back to Rust.
      button.dataset.sequence = String(event.sequence);
      button.setAttribute('aria-current', String(event.sequence === selectedSequence));

      const seq = document.createElement('span');
      seq.className = 'viewer-timeline__meta';
      seq.textContent = String(event.sequence);

      const label = document.createElement('span');
      label.className = 'viewer-timeline__label';
      label.textContent = event.label === '' ? event.kind : event.label;

      const meta = document.createElement('span');
      meta.className = 'viewer-timeline__meta';
      meta.textContent = event.isError ? `${event.kind} · error` : event.kind;
      if (event.isError) meta.setAttribute('data-tone', 'bad');

      button.append(seq, label, meta);
      button.addEventListener('click', () => selectEvent(event.sequence));
      li.append(button);
      timelineEl.append(li);
    }
    if (timelineCountEl !== null) {
      timelineCountEl.textContent =
        selectedAgentId === null
          ? `${events.length} loaded`
          : `${shown.length} of ${events.length} loaded`;
    }
    if (moreEl !== null) moreEl.hidden = !hasMore;
  }

  /** Set when the renderer points at an item that came from no viewer event. */
  let selectionHasNoEvent = false;

  function renderInspector() {
    if (inspectorEl === null) return;
    inspectorEl.replaceChildren();

    const note = (text: string) => {
      const p = document.createElement('p');
      p.className = 'fs-muted';
      p.textContent = text;
      inspectorEl.append(p);
    };

    if (selectionHasNoEvent) {
      // A sidecar. Say so rather than showing the nearest event's content.
      note(NO_EVENT_MESSAGE);
      return;
    }
    if (selectedSequence === null || api === null) {
      note('Select an event or an agent.');
      return;
    }

    let detail: EventDetail | null = null;
    try {
      // Bounded: one event in, one event out, whatever the session's size.
      detail = JSON.parse(api.agent_viewer_event_detail(selectedSequence)) as EventDetail | null;
    } catch {
      detail = null;
    }
    if (detail === null) {
      note(`No event ${selectedSequence} in this session.`);
      return;
    }

    // Selecting an agent does not move the playhead, so the inspector can still
    // be holding another agent's event. Saying whose it is beats showing it
    // under the selected agent's heading.
    const foreign = foreignEventNote(selectedAgentId, detail.agentId, detail.agentLabel);
    if (foreign !== null) {
      note(foreign);
      return;
    }

    const dl = document.createElement('dl');
    for (const field of inspectorFields(detail)) {
      const dt = document.createElement('dt');
      dt.textContent = field.label;
      const dd = document.createElement('dd');
      dd.textContent = field.value;
      if (field.tone !== undefined) dd.setAttribute('data-tone', field.tone);
      dl.append(dt, dd);
    }
    inspectorEl.append(dl);
  }

  /** Ask Rust to move, then re-read. The shell never predicts the answer. */
  function selectEvent(sequence: number) {
    if (api === null) return;
    const moved = api.agent_viewer_seek_sequence(sequence);
    selectedSequence = sequence;
    selectionHasNoEvent = false;
    if (!moved) {
      // A legitimate answer: that event rendered nothing. Say so rather than
      // leaving the graph somewhere unrelated and implying it followed.
      say(`Event ${sequence} produced no renderer entry, so the graph did not move.`);
    }
    refreshShell();
  }

  /**
   * Ask Rust to select, then render Rust's answer.
   *
   * The shell used to decide the new selection itself and then tell the
   * renderer to centre on it, which meant the rail could show a selection the
   * graph never had. Now the renderer decides, including refusing an id it has
   * no node for, and the shell shows what it reported.
   */
  function selectAgent(agentId: string) {
    if (api === null) return;
    let answer: SelectionAnswer;
    try {
      answer = JSON.parse(api.agent_viewer_select_agent(agentId)) as SelectionAnswer;
    } catch {
      return;
    }
    if (answer.outcome === 'unknown') {
      say(`The graph has no node for ${agentId}, so nothing was selected.`);
      return;
    }
    selectedAgentId = answer.selectedAgentId;
    selectionHasNoEvent = false;
    refreshShell();
  }

  /** Clear the graph selection through the renderer. */
  function clearSelection() {
    if (api === null) return;
    if (!api.agent_viewer_clear_selection()) return;
    selectedAgentId = null;
    selectionHasNoEvent = false;
    refreshShell();
  }

  function loadEvents(offset: number) {
    if (api === null) return;
    try {
      const window_ = JSON.parse(api.agent_viewer_events(offset, PAGE)) as EventWindow;
      events = offset === 0 ? [...window_.items] : [...events, ...window_.items];
      hasMore = window_.hasMore;
    } catch {
      events = [];
      hasMore = false;
    }
  }

  function refreshShell() {
    if (api === null) return;
    const snap = snapshot();
    if (snap === null) return;
    // The playhead's own event, reported by Rust through the manifest. `null`
    // means it rests on a renderer item that came from no event.
    if (snap.sequence !== null && selectedSequence === null) selectedSequence = snap.sequence;
    // The renderer's own selection wins over anything the shell was holding.
    // A click inside the canvas, Follow re-tracking, or a reload can all move
    // it without the shell asking, and the rail must not out-vote the graph.
    selectedAgentId = snap.selectedAgentId;
    renderHeader(snap);
    renderRail();
    renderTimeline();
    renderInspector();
    renderStory();
  }

  function reloadShellData() {
    if (api === null) return;
    try {
      agents = JSON.parse(api.agent_viewer_agents()) as AgentSummary[];
    } catch {
      agents = [];
    }
    try {
      graphNodeIds = toGraphNodeIds(JSON.parse(api.agent_viewer_graph_nodes()) as GraphNode[]);
    } catch {
      graphNodeIds = new Set();
    }
    selectedSequence = null;
    selectedAgentId = null;
    loadEvents(0);
    refreshShell();
  }

  // ── Story Mode ────────────────────────────────────────────────────────
  //
  // Reads the facts the Rust side computed. It has no way to assert a capability
  // the session cannot evidence, because the capability manifest comes from the
  // same place the numbers do.

  let chapters: Chapter[] = [];

  function renderStory() {
    if (api === null) return;
    let facts: StoryFacts | null = null;
    try {
      facts = JSON.parse(api.agent_viewer_story_facts()) as StoryFacts | null;
    } catch {
      facts = null;
    }
    if (facts === null) return;

    chapters = chaptersFrom(events, agents);
    const story = localStory(facts, chapters);

    const set = (selector: string, value: string) => {
      const node = document.querySelector(selector);
      if (node !== null) node.textContent = value;
    };
    set('[data-story-source]', story.sourceLabel);
    set('[data-story-outcome]', story.outcome);
    set('[data-story-summary]', story.summary);
    set('[data-story-problem]', story.narrative.problem);
    set('[data-story-action]', story.narrative.action);
    set('[data-story-result]', story.narrative.result);

    const disclosureEl = document.querySelector('[data-story-disclosure]') as HTMLElement | null;
    if (disclosureEl !== null) {
      disclosureEl.hidden = story.disclosure === null;
      disclosureEl.textContent = story.disclosure ?? '';
    }

    const cardsEl = document.querySelector('[data-story-cards]');
    if (cardsEl !== null) {
      cardsEl.replaceChildren();
      for (const card of story.cards) {
        const li = document.createElement('li');
        li.className = 'story__card';
        li.dataset.state = card.state;
        li.dataset.tone = card.tone;
        li.dataset.cardId = card.id;

        const title = document.createElement('p');
        title.className = 'story__card-title';
        title.textContent = card.title;

        const detail = document.createElement('p');
        detail.className = 'story__card-detail';
        detail.textContent = card.detail;

        li.append(title, detail);
        cardsEl.append(li);
      }
    }

    const chaptersEl = document.querySelector('[data-story-chapters]');
    if (chaptersEl !== null) {
      chaptersEl.replaceChildren();
      for (const chapter of story.chapters) {
        const li = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'story__chapter';
        button.textContent = chapter.title;
        button.setAttribute('aria-current', String(chapter.sequence === selectedSequence));
        if (chapter.sequence === null) {
          button.disabled = true;
        } else {
          const sequence = chapter.sequence;
          // A chapter seeks the same way a timeline row does: by canonical
          // sequence, through the manifest.
          button.addEventListener('click', () => selectEvent(sequence));
        }
        li.append(button);
        chaptersEl.append(li);
      }
    }
  }

  document.querySelector('[data-expert-toggle]')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.textContent = open ? 'Open technical evidence' : 'Hide technical evidence';
    for (const panel of document.querySelectorAll('[data-expert]')) {
      (panel as HTMLElement).hidden = open;
    }
  });

  /**
   * The renderer pushes its selection after an input it handled itself.
   *
   * A click lands inside the canvas, which the Astro side never sees, so this
   * is the only way the shell learns that the graph moved. Nothing is polled
   * and nothing is inferred: the payload carries the agent, the renderer index
   * and the sequence the MANIFEST resolved, including `null` when that item
   * came from no event.
   */
  window.addEventListener('fleetscope:viewer-selection', (event) => {
    const raw = (event as CustomEvent<string>).detail;
    let signal: SelectionSignal;
    try {
      signal = JSON.parse(raw) as SelectionSignal;
    } catch {
      return;
    }

    selectedAgentId = signal.selectedAgentId;
    if (signal.sequence === null) {
      // A sidecar: real renderer state, no viewer event behind it.
      selectionHasNoEvent = true;
      selectedSequence = null;
    } else {
      selectionHasNoEvent = false;
      selectedSequence = signal.sequence;
    }
    refreshShell();
  });

  /**
   * Escape clears the graph selection.
   *
   * The renderer handles Escape for itself when the canvas has focus, but a
   * keyboard user working the rail is focused on a DOM button and the canvas
   * never sees the key. This routes it to the same renderer call, so both
   * paths clear the same selection rather than two.
   *
   * Scoped out of text fields so it cannot swallow a native Escape.
   */
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented) return;
    const target = event.target as HTMLElement | null;
    if (target !== null && (target.isContentEditable || /^(input|textarea|select)$/i.test(target.tagName))) {
      return;
    }
    clearSelection();
  });

  toggleEl?.addEventListener('click', () => {
    api?.agent_viewer_toggle_play();
    refreshShell();
  });
  goLiveEl?.addEventListener('click', () => {
    api?.agent_viewer_go_live();
    selectedSequence = null;
    selectionHasNoEvent = false;
    refreshShell();
  });
  fitEl?.addEventListener('click', () => {
    api?.agent_viewer_fit_graph();
  });
  moreEl?.addEventListener('click', () => {
    loadEvents(events.length);
    renderTimeline();
  });

  // The renderer advances its own playhead while replaying, so the header has
  // to re-read rather than assume. One second is well under the granularity a
  // person notices and costs nothing.
  window.setInterval(() => {
    if (api !== null) refreshShell();
  }, 1000);

  dropzone?.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropzone.dataset.dragging = 'true';
  });
  dropzone?.addEventListener('dragleave', () => {
    dropzone.dataset.dragging = 'false';
  });
  dropzone?.addEventListener('drop', async (event) => {
    event.preventDefault();
    dropzone.dataset.dragging = 'false';
    if (!api) return;
    const files = Array.from(event.dataTransfer?.files ?? []);
    if (files.length > 0) await loadFiles(files);
  });

  document.querySelector('[data-pick-file]')?.addEventListener('click', () => fileInput?.click());
  document
    .querySelector('[data-pick-folder]')
    ?.addEventListener('click', () => folderInput?.click());
  document.querySelector('[data-load-demo]')?.addEventListener('click', () => {
    if (api) report(api.agent_viewer_load_demo());
  });

  // Non-standard, and the only way a browser offers a directory picker.
  folderInput?.setAttribute('webkitdirectory', '');

  for (const input of [fileInput, folderInput]) {
    input?.addEventListener('change', async () => {
      if (!api || !input.files) return;
      await loadFiles(Array.from(input.files));
    });
  }

  void boot();
</script>
