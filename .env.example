# FleetScope environment template.
# Copy to `.env` and fill in only what you need. NEVER commit `.env`.
# The default recorded/static path requires none of the GCP or Gemini values below.

APP_ENV=development

# ─── Primary hackathon producer: Google ADK session JSONL ───────────────────
# Safe defaults make no model or network call. The live command additionally
# requires both opt-ins below to be exported as literal "true" in the shell.
GOOGLE_GENAI_USE_VERTEXAI=false
FLEETSCOPE_ALLOW_MODEL_CALLS=false

# Vertex AI / Google Cloud resource identifiers for the fixed
# google-cloud-launch-readiness workflow. Credentials come from ADC; never put
# a service-account key in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
FLEETSCOPE_CLOUD_RUN_SERVICE=
FLEETSCOPE_SESSION_BUCKET=
FLEETSCOPE_SESSION_PREFIX=fleetscope-sessions
FLEETSCOPE_ADK_MODEL=gemini-3.7-flash

# With the fields above filled, this is a zero-cost validation:
#   pnpm demo:google-session
# A real run is always explicit:
#   pnpm demo:google-session -- --run
# Add --upload only when the finished redacted JSONL/proof should be written to
# FLEETSCOPE_SESSION_BUCKET.

# ─── Legacy bounded API path ─────────────────────────────────────────────────
# Retained for existing tests and compatibility. It is not the Session Observer
# demo producer above and must not be used for the hackathon story.
#
# ─── Live mode ────────────────────────────────────────────────────────────────
# false  = recorded path only. Zero cloud calls, zero credit spend. THE DEFAULT.
# true   = enables the single bounded live-proof endpoint in apps/api.
# The public/demo deployment MUST ship with LIVE_MODE=false.
LIVE_MODE=false

# ─── apps/api ─────────────────────────────────────────────────────────────────
PORT=8080
API_LOG_LEVEL=info
# Browser origins allowed to call this API cross-origin, comma separated.
# EMPTY BY DEFAULT (fail closed): with no entry the service sends no CORS header.
# Set it only when the static site is served from a different origin, e.g.
#   WEB_ORIGINS=http://localhost:4321,http://localhost:4331
WEB_ORIGINS=

# ─── Google Cloud (only read when LIVE_MODE=true) ─────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ─── Gemini bounded proof (only read when LIVE_MODE=true) ─────────────────────
# Hard guardrails from docs/design/budget-demo.md — a USD 35 ceiling, not a target.
GEMINI_MODEL=gemini-3.7-flash
# The model API credential. Required when LIVE_MODE=true, ignored otherwise.
# NEVER commit a real value. Set it in the shell or in the deployment's secret
# store; `.env` is gitignored precisely so this cannot happen by accident.
GEMINI_API_KEY=
GEMINI_MAX_INPUT_TOKENS=2000
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_MAX_CALLS_PER_CASE=2
GEMINI_TEMPERATURE=0
GEMINI_TIMEOUT_MS=15000

# Credentials are NOT read from this file in normal operation.
# Locally use `gcloud auth application-default login`; on Cloud Run use the
# service account. Do not paste an API key here.

# ─── run ledger ───────────────────────────────────────────────────────────────
# The append-only record of every admitted run. A run is refused with 503 when
# this path is not writable, because an unrecorded run cannot be audited.
FLEETSCOPE_RUN_LEDGER=.fleetscope/runs.jsonl
# The ceiling on model calls across ALL runs, distinct from the per-run cap. It
# stops a restart loop spending the budget one admissible run at a time.
FLEETSCOPE_TOTAL_CALL_BUDGET=60
# The most model calls ONE run may reserve. Distinct from
# GEMINI_MAX_CALLS_PER_CASE above: that bounds the single-decision
# /live/decision path (2 calls per case), while a scenario run drives a root
# agent and a delegated sub-agent (6). A scenario declaring more than this is
# refused at admission rather than truncated mid-run.
FLEETSCOPE_RUN_MAX_MODEL_CALLS=6
# Who executes an admitted run.
#
#   worker  FleetScope spawns its own Python process. Keep
#           FLEETSCOPE_RUN_WORKER_MODE=pure while developing. The future ADK
#           worker mode uses Vertex ADC/service identity and requires the
#           explicit live settings below; it does not need an API key.
#   mcp     the developer's own Gemini or Antigravity CLI supplies the model on
#           that CLI's auth, and calls FleetScope's MCP tool. FleetScope issues
#           no model call, so no Gemini credential is required. LIVE_MODE=true
#           is still required: it is what allows a run to be admitted at all.
FLEETSCOPE_RUN_DRIVER=worker
# Safe default. Change to `adk` only together with LIVE_MODE=true,
# FLEETSCOPE_ALLOW_MODEL_CALLS=true, GOOGLE_GENAI_USE_VERTEXAI=true and valid
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION values after local verification.
FLEETSCOPE_RUN_WORKER_MODE=pure

# ─── apps/web (PUBLIC_* is exposed to the browser bundle) ─────────────────────
PUBLIC_DEFAULT_CASE_ID=CASE-1042
PUBLIC_LIVE_MODE=false
PUBLIC_API_BASE_URL=
